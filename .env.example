# OpenAI-compatible audio transcription endpoint
STT_API_URL=https://your-stt-service.example/v1/audio/transcriptions
STT_API_KEY=replace-me
STT_MODEL=whisper-1
STT_LANGUAGE=zh
STT_TIMEOUT_SECONDS=60
STT_MAX_AUDIO_BYTES=15728640

# OpenAI-compatible text-to-speech endpoint
TTS_API_URL=https://api.openai.com/v1/audio/speech
TTS_API_KEY=replace-me
TTS_PROVIDER=openai
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=alloy
TTS_RESPONSE_FORMAT=mp3
TTS_TIMEOUT_SECONDS=60

# DashScope users can omit TTS_API_URL/TTS_API_KEY and reuse these instead:
# DASHSCOPE_API_KEY=replace-me
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# STT_PROVIDER=dashscope
# STT_MODEL=qwen3-asr-flash
# TTS_PROVIDER=dashscope
# TTS_MODEL=qwen-audio-3.0-tts-flash
# TTS_VOICE=longanhuan_v3.6
